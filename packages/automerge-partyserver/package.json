{
  "name": "automerge-partyserver",
  "version": "0.1.0",
  "description": "Automerge CRDT sync for PartyKit / partyserver",
  "keywords": [
    "automerge",
    "crdt",
    "collaboration",
    "partykit",
    "partyserver",
    "durable-objects",
    "websocket"
  ],
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/server/index.d.ts",
        "default": "./dist/server/index.d.ts"
      },
      "import": "./dist/server/index.js"
    },
    "./provider": {
      "types": {
        "import": "./dist/provider/index.d.ts",
        "default": "./dist/provider/index.d.ts"
      },
      "import": "./dist/provider/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts"
  },
  "dependencies": {
    "@automerge/automerge": "^3.0.0",
    "@automerge/automerge-repo": "^2.2.0",
    "@automerge/automerge-repo-network-broadcastchannel": "^2.2.0",
    "@automerge/automerge-repo-storage-indexeddb": "^2.2.0",
    "@types/node": "^25.5.0",
    "cborg": "^4.0.0",
    "partyserver": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250813.0",
    "partysocket": "^1.1.16",
    "tsdown": "^0.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
